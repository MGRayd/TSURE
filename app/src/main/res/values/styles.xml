<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">#0A0C12</item>
        <item name="android:navigationBarColor">#0A0C12</item>
        <item name="android:statusBarColor">#0E1119</item>
        <item name="android:colorAccent">#DC1C2E</item>
        <item name="android:alertDialogTheme">@style/TsureDialogTheme</item>
    </style>

    <style name="TsureDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="android:windowNoTitle">false</item>
        <item name="android:colorAccent">#DC1C2E</item>
        <item name="android:textColorPrimary">#F5F7FA</item>
        <item name="android:textColorSecondary">#AEB5C2</item>
        <item name="android:navigationBarColor">#0A0C12</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="ChecklistPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/menu_slide_in</item>
        <item name="android:windowExitAnimation">@anim/menu_slide_out</item>
    </style>
</resources>
